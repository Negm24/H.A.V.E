{
  "name": "have-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './kiosk' --filter './hub' --filter './advisor' --filter './admin' dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @have/kiosk --filter @have/hub --filter @have/advisor --filter @have/admin build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
