# Kiosk server/device-agent credentials only. Never use VITE_ prefixes.
# Use the exact serial and generated key from backend provision_terminal.
# SIMULATOR_ID is a random 32-character hex selector, NOT a device credential.
# Generate each selector in PowerShell: [guid]::NewGuid().ToString('N')
# Open http://localhost:5173/?terminal=THE_SIMULATOR_ID in a separate tab per device.
TERMINAL_HAVE_TEST_001_SERIAL=HAVE-TEST-001
TERMINAL_HAVE_TEST_001_KEY=
TERMINAL_HAVE_TEST_001_SIMULATOR_ID=

TERMINAL_HAVE_TEST_002_SERIAL=HAVE-TEST-002
TERMINAL_HAVE_TEST_002_KEY=
TERMINAL_HAVE_TEST_002_SIMULATOR_ID=
# The optional ngrok authtoken/hostname belong in the ROOT .env, not here.
