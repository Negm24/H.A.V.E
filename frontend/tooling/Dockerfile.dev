FROM node:24.11.1-bookworm-slim
WORKDIR /workspace
RUN npm install --global pnpm@11.25.0
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY kiosk/package.json ./kiosk/package.json
COPY hub/package.json ./hub/package.json
COPY advisor/package.json ./advisor/package.json
COPY admin/package.json ./admin/package.json
COPY shared/package.json ./shared/package.json
RUN pnpm install --frozen-lockfile
COPY . .
# Only source/config files are bind-mounted by Compose. Dependencies stay in
# the container; no Windows node_modules and no stale dependency volumes.
CMD ["pnpm", "--filter", "@have/kiosk", "dev"]
