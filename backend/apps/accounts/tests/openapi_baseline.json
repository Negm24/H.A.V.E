    "/api/v1/auth/owners/login/": {
      "post": {
        "operationId": "v1_auth_owners_login_create",
        "description": "Use an existing privately provisioned owner's phone and password. Sets an HttpOnly session cookie; no JWT or Remember Me. Expires after 10 minutes idle or 2 hours total. Swagger supplies CSRF automatically. Reload docs after login to pick up the rotated CSRF token. Wrong credentials, lockout and unavailable Redis all deny login.",
        "summary": "Sign in as an owner",
        "tags": [
          "Owner authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnerLogin"
              },
              "examples": {
                "ReplaceWithYourOwnOwnerCredentials": {
                  "value": {
                    "phone_number": "01112345678",
                    "password": "YOUR_OWNER_PASSWORD"
                  },
                  "summary": "Replace with your own owner credentials"
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/OwnerLogin"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/OwnerLogin"
              }
            }
          },
          "required": true
        },
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerIdentity"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": "Invalid or missing input fields."
