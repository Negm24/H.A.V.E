  "components": {
    "schemas": {
      "CsrfToken": {
        "type": "object",
        "properties": {
          "csrf_token": {
            "type": "string",
            "readOnly": true
          }
        },
        "required": [
          "csrf_token"
        ]
      },
      "CustomerIdentity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "account_type": {
            "type": "string",
            "readOnly": true
          },
          "first_name": {
            "type": "string",
            "readOnly": true
          },
          "last_name": {
            "type": "string",
            "readOnly": true
          },
          "phone_number": {
            "type": "string",
            "readOnly": true
          },
          "email": {
            "type": "string",
            "format": "email",
            "readOnly": true
          },
          "date_of_birth": {
            "type": "string",
            "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
            "example": "24-01-2005",
            "readOnly": true
          },
          "phone_verified_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "required": [
          "account_type",
          "date_of_birth",
          "email",
          "first_name",
          "id",
          "last_name",
          "phone_number",
          "phone_verified_at"
        ]
      },
      "CustomerLogin": {
        "type": "object",
        "properties": {
          "phone_number": {
            "type": "string",
            "maxLength": 32
          },
          "pin": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 4,
            "pattern": "^[0-9]{4}$"
          }
        },
        "required": [
          "phone_number",
          "pin"
        ]
      },
      "CustomerSignup": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "maxLength": 32
          },
          "last_name": {
            "type": "string",
            "maxLength": 32
          },
          "phone_number": {
            "type": "string",
            "maxLength": 32
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 128
          },
          "date_of_birth": {
            "type": "string",
            "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
            "example": "24-01-2005"
          },
          "pin": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 4,
            "pattern": "^[0-9]{4}$"
          }
        },
        "required": [
          "date_of_birth",
          "email",
          "first_name",
          "last_name",
          "phone_number",
          "pin"
        ]
      },
      "CustomerSignupChallenge": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid"
          },
          "expires_in": {
            "type": "integer"
          },
          "resend_after": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "detail",
          "expires_in",
          "resend_after"
        ]
      },
      "CustomerSignupVerification": {
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid"
          },
          "phone_number": {
            "type": "string",
            "maxLength": 32
          },
          "code": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 6,
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "challenge_id",
          "code",
          "phone_number"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "detail"
        ]
      },
      "HubLogin": {
        "type": "object",
        "properties": {
          "phone_number": {
            "type": "string",
            "maxLength": 32
          },
          "pin": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 4,
            "pattern": "^[0-9]{4}$"
          },
          "remember_me": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "phone_number",
          "pin"
        ]
      },
      "HubSession": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer"
          },
          "customer": {
            "$ref": "#/components/schemas/CustomerIdentity"
          }
        },
        "required": [
          "access_token",
          "customer",
          "expires_in",
          "token_type"
        ]
      },
      "OwnerIdentity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "account_type": {
            "type": "string",
            "readOnly": true
          },
          "first_name": {
            "type": "string",
            "readOnly": true
          },
          "last_name": {
            "type": "string",
            "readOnly": true
          }
        },
        "required": [
          "account_type",
          "first_name",
          "id",
          "last_name"
        ]
      },
      "OwnerLogin": {
        "type": "object",
        "properties": {
          "phone_number": {
            "type": "string",
            "maxLength": 32
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 128
          }
        },
        "required": [
          "password",
          "phone_number"
        ]
      },
      "TerminalSession": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "idle_expires_in": {
            "type": "integer"
          },
          "session_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/CustomerIdentity"
          }
        },
        "required": [
          "idle_expires_in",
          "session_id"
        ]
      }
    },
    "securitySchemes": {
      "HubBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "TerminalBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque session token"
      },
      "TerminalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Terminal-Key"
      },
      "TerminalSerial": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Terminal-Serial"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  }
}
