# PostgreSQL
POSTGRES_DB=name-of-the-database
POSTGRES_USER=name-of-user
POSTGRES_PASSWORD=password123
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis
REDIS_URL=redis://127.0.0.1:6379/0


# Terminal credentials are generated by provision_terminal (see backend/AUTH_GUIDE.md).
# The backend does not read Terminal-ID environment variables. Keep device keys private.
