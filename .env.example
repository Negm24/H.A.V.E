# PostgreSQL
POSTGRES_DB=name-of-the-database
POSTGRES_USER=name-of-user
POSTGRES_PASSWORD=password123
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Doctor MFA: Fernet key that encrypts TOTP secrets at rest. Local settings fall
# back to a public development key when empty. Generate a private one with:
# docker compose exec backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes every enrolled doctor's authenticator unusable.
MFA_ENCRYPTION_KEY=

# Doctor application notifications (local settings print email to the backend log).
OWNER_NOTIFICATION_EMAIL=


EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=test@example.com
EMAIL_HOST_PASSWORD=1234 1234 1234 1234
DEFAULT_FROM_EMAIL=test@example.com
EMAIL_TIMEOUT=15
# Optional phone-camera testing with ngrok. Never commit a real authtoken.
NGROK_AUTHTOKEN=
HUB_TUNNEL_HOST=
